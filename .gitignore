__pycache__/
*.pyc
.pytest_cache/
.tmp/
.codex-remote-attachments/
.venv/
venv/
build/
dist/
release/
*.log
.env
.env.*

# Local test, audit, and release-preparation workspaces
/artifacts/
/.artifacts/
/.codex-*/
/.codex_*/
/.popup-regression-run/
/.release-smoke/
/.selector-layout-audit-*/
/.test-temp/
/.tmp_*/
/tmp*/
/$testRoot/
/tests/.tmp*/

# Historical build variants and local diagnostics
/build-*/
/dist-*/
/release-*/
/events.jsonl
/trace_*.txt
/design-qa.md

# Downloaded third-party runtime binary
bin/mihomo.exe

# Sensitive local configuration
config.yaml
config.local.yaml
sources.yaml
nodes.yaml
*.private.yaml
secrets*.yaml
*.pfx
*.pem
*.key

# Runtime data
data/

# New UI front end (T-P4-01): installed packages and build output are not sources
ui/node_modules/
ui/dist/
shell/app/ui/
# ui/fonts/ is refreshed from node_modules by ui/build/fonts.mjs, except the local
# zh font (a renamed OFL subset) whose woff2 and license are sources.
ui/fonts/*
!ui/fonts/tesseract-kai-zh.woff2
!ui/fonts/OFL-tesseract-kai.txt
# ...but ui/build/ (build plugins) and ui/src/data/ are sources despite build/ and data/ above
!ui/build/
!ui/src/data/

# Local agent / editor state and working notes (never published)
/.build/
/.claude/
/.codex/
/.agents/

# Local test scratch directories
/.pytest-*/
/.test*/
/test-*/
/pytest-cache-files-*/

# Generated by the build scripts (app_version.txt is written from app_info.py
# for a build and restored afterwards; tier3_build_id.json is a build output)
/app_version.txt
/tier3_build_id.json
