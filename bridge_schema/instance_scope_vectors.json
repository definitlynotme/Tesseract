{
  "version": 3,
  "custom_identity": {
    "input": "strictly resolved existing absolute config and data directories, in that order",
    "rules": {
      "path": "apply Windows ntpath.normpath, remove an extended drive or UNC prefix, then apply ntpath.normpath again",
      "case_mapping": "map the complete path with LCMapStringEx(LOCALE_NAME_INVARIANT, LCMAP_UPPERCASE); this is Windows invariant-locale UTF-16 mapping, not Unicode default upper/casefold or locale-sensitive casing",
      "unicode_normalization": "do not apply NFC, NFD, NFKC, or NFKD; preserve combining and compatibility characters after case mapping",
      "encoding": "remove the terminating UTF-16 NUL returned by LCMapStringEx, then encode the mapped path as UTF-8",
      "rust": "call windows-sys Win32::Globalization::LCMapStringEx with locale name \"\", LCMAP_UPPERCASE, and a NUL-terminated UTF-16 source using cchSrc=-1; remove the returned terminal NUL and convert the mapped UTF-16 result to UTF-8"
    },
    "domain_prefix": "tesseract-instance-scope-v1\u0000",
    "framing": "prefix bytes, then each path as 4-byte big-endian UTF-8 byte length followed by its UTF-8 bytes",
    "digest": "first 24 lowercase hex digits of SHA-256",
    "scope_label": "TESSERACT_INSTANCE_SCOPE opts in but does not alter identity for the same directory pair"
  },
  "cases": [
